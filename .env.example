# Copy this file to .env and fill in values. Never commit .env.

FLASK_SECRET_KEY=change-me-generate-with-python3-c-import-secrets-print-secrets-token-hex-32
FLASK_ENV=development

# Gmail SMTP (create dedicated address + App Password)
GMAIL_ADDRESS=yourproject@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Auth0 (leave blank when AUTH_REQUIRED=False)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_CALLBACK_URL=http://localhost:5000/callback

# Google Sheets data capture
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_JSON=
