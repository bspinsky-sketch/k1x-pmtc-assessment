# Copy this file to .env and fill in values. Never commit .env.

FLASK_SECRET_KEY=change-me-generate-with-python3-c-import-secrets-print-secrets-token-hex-32
FLASK_ENV=development

# Gmail SMTP (create dedicated address + App Password)
GMAIL_ADDRESS=yourproject@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Google Sheets data capture
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_JSON=
